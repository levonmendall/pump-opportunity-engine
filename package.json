{
  "name": "pump-opportunity-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-bigint-buffer.mjs",
    "build": "tsc --noEmit",
    "compile": "tsc --outDir dist --noEmit false",
    "dashboard": "node dist/src/dashboard.js",
    "test": "node --import tsx --test test/*.test.ts",
    "integration": "node --use-env-proxy --import tsx src/integration.ts",
    "account": "node --import tsx src/account.ts",
    "runtime": "node --use-env-proxy --import tsx src/runtime.ts",
    "publisher": "node dist/src/snapshot-publisher.js"
  },
  "dependencies": {
    "@pump-fun/pump-swap-sdk": "2.2.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "better-sqlite3": "13.0.3",
    "bn.js": "5.2.3",
    "bs58": "6.0.0",
    "https-proxy-agent": "7.0.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/bn.js": "5.2.0",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@coral-xyz/anchor": {
      "toml": "5.0.1"
    },
    "@solana/web3.js": {
      "jayson": "5.0.0"
    }
  }
}
