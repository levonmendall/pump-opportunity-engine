# Secret-free template. Never put populated copies in git.
# Gate A free read-only integration (no provider key required).
POE_RPC_URL=https://api.mainnet.solana.com
POE_CAPTURE_SECONDS=300

# Future metered verification experiment ONLY. Not consumed by free integration.
# Future adapter: prefer an EC2 systemd LoadCredential file. Only actual securely
# materialized secret-file/runtime bindings work; network placeholders do not.
# Never attach provider secrets to Render or paste them into chat.
POE_PUMPPORTAL_API_KEY=
POE_PUMPPORTAL_SECRET_FILE=
POE_DATA_WALLET=
# Approved initial experiment, not approved continuous acceptance operation:
POE_DATA_DAILY_LAMPORTS=10000000
POE_DATA_TOTAL_LAMPORTS=40000000
POE_DATA_DAILY_USD_MICROS=2500000
POE_DATA_TOTAL_USD_MICROS=10000000
POE_DATA_WALLET_FLOOR_LAMPORTS=20000000

# Dashboard: ONLY these identifiers and reporting/viewer credentials reach Render.
# Values must come from the future authoritative POE account/release, not fixtures.
POE_ACCOUNT_ID=
POE_INCEPTION_AT=
POE_RUNTIME_RELEASE=
POE_STRATEGY_VERSION=
POE_VIEWER_USER=
POE_VIEWER_PASSWORD=
POE_INGEST_SECRET=
PORT=10000

# EC2 observer only: a separately provisioned nonfinancial read-only projection.
# Never put its directory inside the private financial directory.
POE_PUBLIC_STATUS_PATH=/var/lib/poe-public/status.json
