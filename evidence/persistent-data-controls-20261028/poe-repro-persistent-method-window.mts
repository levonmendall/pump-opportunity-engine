import {mkdtempSync,writeFileSync,readFileSync,rmSync} from 'node:fs';import{tmpdir}from'node:os';import{join}from'node:path';import{createHash}from'node:crypto';
import{readResearchBaseline}from'../../src/research-baseline.ts';import{PilotRpc}from'../../src/pilot-rpc.ts';
const dir=mkdtempSync(join(tmpdir(),'poe-OFFLINE-review-maxpaths-')),paths:string[]=[];const sha=(s:string)=>createHash('sha256').update(s).digest('hex');let at=100000000,legacy={schemaVersion:1,calls:2,bytes:100,lastObservedAt:at-100000000+1000,starts:[900,1000],pending:[],blockedReason:'RPC_HTTP_429'};let raw=JSON.stringify(legacy)+'\n';let p=join(dir,'old.json');writeFileSync(p,raw,{mode:0o600});paths.push(p);let b:any={calls:2,bytes:100,starts:[900,1000],refusal:'RPC_HTTP_429',refusalAt:1000,sha256:sha(raw)};
for(let i=0;i<511;i++){const t=2000+i*60000,state={schemaVersion:1,grantId:'prior-'+i,baseline:b,startedAt:t,lastObservedAt:t,starts:[t],actualInvocations:[{id:b.calls+1,at:t}],httpBytes:0,wsBytes:0,pending:[],haltedReason:null};raw=JSON.stringify(state)+'\n';p=join(dir,'prior-'+i+'.json');writeFileSync(p,raw,{mode:0o600});paths.push(p);b={...b,calls:b.calls+1,starts:[...b.starts,t],sha256:sha(raw)};}
try{readResearchBaseline({paths,now:at,physicalSettled:true,allowCumulativeBeyondLegacy:true,maximumPaths:512});let mono=0;const client=new PilotRpc({directory:join(dir,'run'),runId:'maxpaths-review',persistent:true,baselinePaths:paths,priorPhysicalSettled:true,priorCooldownUntil:0,chapterUnits:1,maxChapters:1,maxGetTransactionStartsPer10s:8,maxResponseBytes:4*1024*1024,now:()=>at,monotonic:()=>mono,sleep:async(ms:number)=>{at+=ms;mono+=ms;},fetcher:(async(_url:any,init:any)=>new Response(JSON.stringify({jsonrpc:'2.0',id:JSON.parse(init.body).id,result:123})))as typeof fetch});console.log('CONSTRUCTOR_OK',paths.length);console.log('FIRST',await client.call('getSlot'));console.log('METHOD_READY',client.methodReadyAt('getTransaction',8),'NOW',at,'RECENT_CHECKPOINT',client.usage().chapterUsage?.baseline.starts.filter((t:number)=>t>at-10000));try{await client.call('getSlot');console.log('SECOND_OK');}catch(e){console.log('SECOND_FAILURE',String(e));}try{client.close();}catch(e){console.log('CLOSE_FAILURE',String(e));}}finally{rmSync(dir,{recursive:true,force:true});}
