 writeFileSync('evidence/two-position-operating-20261029/http429-recovery.json',JSON.stringify({classification:'OFFLINE_DISPOSABLE_FAKE_HTTP429_GENUINE_INTERRUPTION_FAIL_CLOSED',networkRequests:0,positionsOpened:1,secondExposureWithheld:true,protectionBreaches:f.protectionBreaches,providerRecoveryProtectionCompletedAt:last.at,duplicateFills:0,restartPositionsPreserved:true,physicalStarts:f.physicalStarts,records:f.records.filter(row=>/technical|entry-preparation|entry-permission|entry-unavailable/.test(row.kind)||row.kind==='http-headers'&&row.data.status>=400),limitations:['Synthetic provider latency and429; actual existing backoff causes unavailable protection and is not an accepted healthy-provider interval.','No claim that free resources can eliminate provider outages or preserve valid marks during missing data.']},null,2)+'\n');
