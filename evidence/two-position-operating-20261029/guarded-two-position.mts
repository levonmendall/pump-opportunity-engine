 const {f,mints}=await openTwo(t,350,false,1),mint=mints[1]!,first=structuredClone(f.ledger.state().positions[mints[0]!]!);f.throttleNextCandidate();let lastTradeBucket=-1;
 const until=f.at+20000;while(f.at<until){const bucket=Math.floor(f.at/10000);if(bucket!==lastTradeBucket){f.continuedTrade(mint);lastTradeBucket=bucket;}await f.protect(true);await f.sourceStep();if(f.bridge.candidateDue(mint))await f.candidate(mint);await advanceProtected(f,f.at+50);}
 assert.ok(f.records.some(row=>row.kind==='http-headers'&&row.data.status===429));assert.ok(f.records.some(row=>row.kind==='native-paper-entry-preparation-unavailable'));assert.deepEqual(f.ledger.state().positions[mints[0]!],first);assert.equal(Object.keys(f.ledger.state().positions).length,1);assert.deepEqual(f.ledger.state().pending,{});assert.equal(f.ledger.state().executionCosts,'7000');assert.ok(f.protectionBreaches.length>0,'a real unavailable quote interval is retained, never relabeled as successful protection');assert.equal(f.ledger.state().controls.entriesEnabled,false);assert.equal(f.bridge.trader.entryReadinessSafety().newHardPauseObserved,true);assert.ok(f.records.some(row=>row.kind==='native-paper-entry-unavailable'&&row.data.reason==='financial-entry-control-authority-unavailable'));
