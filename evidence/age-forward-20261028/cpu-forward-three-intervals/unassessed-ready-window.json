    {
      "line": 149,
      "text": "  if(input.candidatePending)return {admitted:false,latestStartAt:input.now-1,reason:'required-existing-candidate-enrichment-has-priority'};"
    },
    {
      "line": 244,
      "text": "    const lowerAdmission=(bound=1200)=>{const at=Date.now(),held=Object.keys(currentLedger.state().positions).length,view=pilotLowerPriorityAdmission({now:at,endAt,held,lastUsable,nextPendingAt:trader.nextDueAt(),operationBoundMs:bound,candidatePending:workKind!=='enrichment'&&!!feeds?.peekHint()});return held&&!pilotDiscretionaryAdmission(discretionaryStarts,at).admitted?{admitted:false,latestStartAt:at-1,reason:'held-discretionary20-of-shared60-reserve'}:view;};"
    },
    {
      "line": 385,
      "text": "      if(evaluate&&rpc.available()&&lowerAdmission().admitted){const mint=evaluate.proof.identity.baseMint;busy=true;workKind='candidate';try{if(!candidateOnly&&candidateReadyAt(mint,now)&&capacity&&!candidateRecordingClosed&&newRiskCapacity&&hasPrice&&held<configuration.maximumPositions&&!pending.length){const at=Date.now();ledger.reconcile('pilot-ready-reconcile:'+state.revision+':'+at,at,price!,usableContextMarks(at));const traffic=feeds.usage().lastAnyTrafficAt;if(traffic!==null&&at-traffic<=2000&&!ledger.state().controls.entriesEnabled){const result=ledger.resume('pilot-ready-resume:'+ledger.state().revision+':'+at,at,price!,usableContextMarks(at),{version:configuration.contract.version,evidence:'pilot-contract:'+configuration.contractSha256,marketAt:traffic,recoveryComplete:true,candidateWindowsReady:true,budgetAvailable:true});if(result.enabled)entryEnabledAt??=at;}}}catch(e){reject('candidate-risk-readiness-unavailable',{mint,reason:safe(e)});}finally{busy=false;workKind='idle';}if(!candidateOnly&&candidateReadyAt(mint,now)&&!newRiskCapacity)reject('entry-capacity-refusal',{mint,rollingDiscretionaryStarts:pilotDiscretionaryAdmission(discretionaryStarts,now),held});evaluate.lastEvaluatedAt=Date.now();await tick('candidate',{candidateMint:mint,reuseFreshContext:true});continue;}"
    }
  ],
