+ p.start();try{t.mock.timers.tick(0);await new Promise<void>(r=>setImmediate(r));assert.deepEqual(calls.map(c=>c.sequence),['12']);
+  await advancePublisherClock(t,11000);for(const sequence of['13','14','15']){writeFileSync(file,JSON.stringify(freshSnapshot(sequence,Date.now())));await advancePublisherClock(t,1000);}
