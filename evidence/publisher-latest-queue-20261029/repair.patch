+ let remaining=milliseconds;while(remaining>0){const n=Math.min(1000,remaining);t.mock.timers.tick(n);await new Promise<void>(r=>setImmediate(r));remaining-=n;}
+}
+function freshSnapshot(sequence:string,at:number):Snapshot{return {...snapshot(),sequence,times:{...snapshot().times,generatedAt:iso(at)}};}
