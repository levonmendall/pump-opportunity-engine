 }
 const gaps=completions.slice(1).map((at,n)=>at-completions[n]!);assert.ok(gaps.every(gap=>gap<=2000));assert.equal(f.ledger.state().executionCosts,'14000');const startsBefore=rpc.usage().newUnits;await assert.rejects(rpc.call('getSignaturesForAddress',['11111111111111111111111111111111'],undefined,{latestStartAt:f.at-1}),/DISPATCH_EXPIRED/);assert.equal(rpc.usage().newUnits,startsBefore,'an expired discretionary request cannot consume holding capacity');
 f.restart();f.at+=1000;await f.bridge.protection();assert.equal(Object.keys(f.bridge.valuation().marks).length,2);assert.deepEqual(f.ledger.state().positions,positions);assert.deepEqual(f.ledger.state().pending,{});
 f.at=Math.max(...Object.values(f.ledger.state().positions).map(p=>p.enteredAt))+900000;await f.bridge.protection();assert.equal(Object.values(f.ledger.state().pending).filter(o=>o.side==='sell').length,2);f.at+=1000;
 for(let n=0;n<6&&Object.keys(f.ledger.state().positions).length;n++)await f.bridge.protection();const final=f.ledger.state();assert.deepEqual(final.positions,{});assert.deepEqual(final.pending,{});assert.equal(final.executionCosts,'28000');assert.equal(final.inceptionAt,initial.inceptionAt);assert.equal(final.initialMicroUsd,initial.initialMicroUsd);const locked=Object.values(final.lockedDeposits).reduce((sum,value)=>sum+BigInt(value),0n);assert.equal(BigInt(final.lamports)+locked-BigInt(initial.lamports),BigInt(final.realizedLamports));
 const journal=f.ledger.exportJournal(1000)as Array<{kind:string;action_id:string}>;assert.equal(journal.filter(r=>r.kind==='inception').length,1);const fills=f.records.filter(r=>r.kind==='trader-execution'&&r.data.status==='filled');assert.equal(fills.length,4);assert.equal(new Set(fills.map(r=>r.data.orderId)).size,4);assert.ok(mints.every(mint=>!final.positions[mint]));
