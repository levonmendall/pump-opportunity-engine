test('OFFLINE two held positions survive HTTP429 and an unsettled physical timeout without false marks, duplicate actions or lost accounting',async t=>{
 const {f,initial}=await twoPacedPositions(t),rpc=f.rpc!,positions=structuredClone(f.ledger.state().positions),gas=f.ledger.state().executionCosts;
 f.throttleNext();await f.bridge.protection();assert.deepEqual(f.ledger.state().positions,positions);assert.deepEqual(f.ledger.state().pending,{});assert.deepEqual(f.bridge.valuation().marks,{});assert.equal(f.ledger.state().controls.entriesEnabled,false);assert.equal(f.ledger.state().executionCosts,gas);const until=rpc.cooldownUntil();assert.ok(until>f.at);const starts=rpc.usage().newUnits;await f.bridge.protection();assert.equal(rpc.usage().newUnits,starts,'provider Retry-After cannot be bypassed by a holding tick');assert.deepEqual(f.ledger.state().positions,positions);
 f.at=until;await f.bridge.protection();assert.equal(Object.keys(f.bridge.valuation().marks).length,2);const uncertaintyAfter429=rpc.usage().uncertainResponseBytes;assert.equal(uncertaintyAfter429,2*1024*1024);
 f.stallNext();const request=rpc.call('getSignaturesForAddress',['11111111111111111111111111111111',{commitment:'confirmed',limit:100}],undefined,{timeoutMs:20,queryTimeoutScope:'independent-history'});await assert.rejects(request,/PHYSICAL_TIMEOUT/);assert.equal(rpc.usage().inFlight,1);const invoked=f.physicalStarts.length;await f.bridge.protection();assert.equal(f.physicalStarts.length,invoked,'an aborted caller never releases the still-owned physical operation');assert.deepEqual(f.bridge.valuation().marks,{});assert.deepEqual(f.ledger.state().positions,positions);assert.deepEqual(f.ledger.state().pending,{});assert.equal(f.ledger.state().executionCosts,gas);assert.throws(()=>rpc.close(),/PHYSICAL_SLOT_OCCUPIED/);
 f.at+=3000;await assert.rejects(rpc.call('getMultipleAccounts',[[],{commitment:'confirmed'}]),/PHYSICAL_SLOT_OCCUPIED/);assert.equal(f.physicalStarts.length,invoked);f.releaseStall();for(let n=0;n<10&&rpc.usage().inFlight;n++)await new Promise(resolve=>setImmediate(resolve));assert.equal(rpc.usage().inFlight,0);assert.equal(rpc.usage().uncertainResponseBytes,uncertaintyAfter429+2*1024*1024);await f.bridge.protection();assert.equal(Object.keys(f.bridge.valuation().marks).length,2);assert.deepEqual(f.ledger.state().positions,positions);assert.deepEqual(f.ledger.state().pending,{});assert.equal(f.ledger.state().executionCosts,gas);assert.equal(f.ledger.state().inceptionAt,initial.inceptionAt);
 const before=f.physicalStarts.length;await assert.rejects(rpc.call('getSignaturesForAddress',['11111111111111111111111111111111'],undefined,{latestStartAt:f.at-1}),/DISPATCH_EXPIRED/);assert.equal(f.physicalStarts.length,before);f.restart();f.at+=1000;await f.bridge.protection();assert.equal(Object.keys(f.bridge.valuation().marks).length,2);assert.deepEqual(f.ledger.state().positions,positions);assert.equal(f.physicalUsage().maximum,1);
 retainPacedTrace('adverse.raw.json',f);
 t.diagnostic(JSON.stringify({classification:'OFFLINE_DISPOSABLE_ADVERSE_CONTROL',networkRequests:0,positionsPreserved:2,pendingActions:0,modeledGasLamports:gas,explicitHttp429:1,realTimerTimeoutMs:20,unsettledTransportBlockedReplacement:true,uncertainResponseBytes:rpc.usage().uncertainResponseBytes,physicalMaximum:f.physicalUsage().maximum,financialInceptionPreserved:true,limitation:'Injected429 and real timer over a fake fetch that ignores cancellation; not provider failure-frequency or installed supervisor recovery acceptance. No adverse simulated fill was manufactured.'}));
});
