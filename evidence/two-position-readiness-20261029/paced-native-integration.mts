async function twoPacedPositions(t:TestContext){
 const f=fixture(t,true,true);await f.open();f.warm();await f.audit();const initial=f.ledger.state(),mints=f.retained.map(r=>r.proof.quote.mint as string);
 // The second candidate receives a real fixture packet in the next open
 // bucket BEFORE entry preparation consumes time; nothing is reconstructed.
 f.continuedTrade(mints[1]!);
 for(let n=0;n<mints.length;n++){const mint=mints[n]!;assert.equal((await f.bridge.candidate(mint,true)).kind,'evaluated');
  if(!Object.values(f.ledger.state().pending).some(order=>order.side==='buy')){
   assert.equal(n,1);assert.ok(f.bridge.trader.decisions().some(d=>d.mint===mint&&d.stage==='missing-data'&&d.reason==='fresh-size-specific-quote-unavailable'),'the expired original quote attempt must remain visible');
   await f.audit(3);assert.equal((await f.bridge.candidate(mint,true)).kind,'evaluated');
  }
  assert.equal(Object.values(f.ledger.state().pending)[0]?.side,'buy',JSON.stringify(f.bridge.trader.decisions()));f.at+=1000;await f.bridge.protection();assert.ok(f.ledger.state().positions[mint],'the paced, actual-size SDK execution must really fill');f.engine.syncFinancialOwnership();f.bridge.maintain();}

 assert.equal(Object.keys(f.ledger.state().positions).length,2);assert.equal(f.ledger.state().executionCosts,'14000');assert.deepEqual(f.ledger.state().pending,{});return {f,initial,mints};
}

