import{mkdtempSync,readFileSync}from'node:fs';import{tmpdir}from'node:os';import{join}from'node:path';import{BoundedRotatingRecorder}from'../../src/retained-recorder.ts';
const root=mkdtempSync(join(tmpdir(),'poe-OFFLINE-refusal-range-'));let at=1000000,mono=0;const directory=join(root,'service');const r=new BoundedRotatingRecorder({directory,segmentBytes:4096,diagnosticBytes:12288,minRetentionMs:300000,minimumDiskReserveBytes:0,now:()=>at,monotonic:()=>mono});let accepted=0;while(accepted<100&&r.record('raw',{raw:'x'.repeat(1500)}))accepted++;await r.maintenance();at+=50;mono+=50;const refusedAt=at;const refused=r.record('required-selected-event',{raw:'MISSING_REQUIRED_EVIDENCE'+ 'z'.repeat(1500)});await r.maintenance();at+=300001;mono+=300001;await r.maintenance();const newAccepted=r.record('fresh-later',{raw:'LATER_EVIDENCE'});const pin=await r.pinRange('actual-refusal-inside',1000001,1000100);const state=JSON.parse(readFileSync(join(directory,'state.json'),'utf8'));console.log(JSON.stringify({accepted,refusedAt,recordAccepted:refused,newAccepted,refusedRecords:r.usage().refusedRecords,refusalReceipts:state.receipts.filter((x:any)=>x.kind==='record-refused').map((x:any)=>x.at),pin}));await r.close();
